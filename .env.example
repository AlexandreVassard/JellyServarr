###########################################
#         Base directory                  #
###########################################

# Base directory for all application data (config, mounts, data, bin).
# Must match the APP_BASE_DIR used during installation.
APP_BASE_DIR=/opt/jellyservarr

###########################################
#         Jellyfin configuration          #
###########################################

# No claim token needed — Jellyfin is fully open-source and self-hosted.

###################################################
#         Linuxserver stack configuration         #
###################################################

# PUID and PGID define the user and group ID applications runs as inside the container.
# Set these to match your host user to avoid permission problems with media files.
PUID=1000
PGID=1000

# Timezone for the linuxserver images (affects logs and scheduling).
# You can replace 'Etc/UTC' with your local timezone, e.g., 'Europe/Paris'
TZ=Etc/UTC

#########################################
#         Traefik configuration         #
#########################################

TRAEFIK_HOST=domain.tld

# Email address used by Traefik to register Let's Encrypt TLS certificates.
TLS_CERTIFICATE_MAIL=

# Host address Traefik binds 80/443 to. Leave as 0.0.0.0 to listen on every
# interface. Set it to a single address (e.g. 192.168.1.41) when another
# service already holds those ports on a different interface — a Tailscale
# Funnel or a VPN endpoint — since binding 0.0.0.0 fails in that case.
TRAEFIK_BIND_IP=0.0.0.0

###########################################
#         WebDAV / rclone configuration   #
###########################################

# Path inside the WebDAV remote. Leave empty to mount its root.
WEBDAV_PATH=

# How often the sidecar refreshes the rclone VFS cache and re-syncs the
# library symlinks, in seconds. Also used as rclone's --dir-cache-time.
WEBDAV_REFRESH_INTERVAL=60

# Disk budget for the rclone VFS cache under data/rclone/cache.
WEBDAV_VFS_CACHE_MAX_SIZE=10G

# The remaining rclone tuning (cache mode, chunk sizes, buffer, streams) is
# inlined in compose.yml — edit it there if you really need to change it.

###########################################
#         Jellyfin scan configuration     #
###########################################

# The sidecar asks Jellyfin for a library scan whenever it adds or removes
# a symlink. Set to false to never trigger one.
JELLYFIN_ENABLE_SCAN=true
JELLYFIN_URL=http://jellyfin:8096

# Jellyfin API key — see the post-install section of the README.
JELLYFIN_TOKEN=
