#######################################
#         Plex configuration         #
#######################################

# Plex claim token — **REQUIRED** when running Plex in Docker.
# Without this, the server cannot be claimed in most Docker setups.
# This is because Plex may not recognize LAN connections as local from inside Docker,
# which blocks access to the setup/claim UI.
# Get your token here: https://plex.tv/claim
PLEX_CLAIM=

###################################################
#         Linuxserver stack configuration         #
###################################################

# PUID and PGID define the user and group ID applications runs as inside the container.
# Set these to match your host user to avoid permission problems with media files.
PUID=1000
PGID=1000

# Timezone for the linuxserver images (affects logs and scheduling).
# You can replace 'Etc/UTC' with your local timezone, e.g., 'Europe/Paris'
TZ=Etc/UTC

# Controls how Plex updates are managed by the container.
# Options:
#   docker  - Default. Lets Docker manage the version. The image always uses the latest public build.
#   latest  - Updates Plex to the latest version you are entitled to (Plex Pass or public).
#   public  - For Plex Pass users who want to stay on the latest public release (not beta).
#   <version> - Use a specific version (e.g., 1.32.5.7349-8f4248874). Must match your Plex account access.
# This setting does not change the image version, but how the container fetches and applies Plex updates.
VERSION=docker

#########################################
#         Traefik configuration         #
#########################################

TRAEFIK_HOST=domain.tld

#######################################
#         Homer configuration         #
#######################################

# IP address where the Homer dashboard is hosted (usually the host IP).
HOMER_LOCAL_IP=192.168.1.41
