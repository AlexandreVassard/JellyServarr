######################################################################
#                                                                    #
#  ⚠️  DO NOT EDIT THIS FILE DIRECTLY                               #
#                                                                    #
#  This is a template file for configuration defaults.               #
#  To customize your settings, copy this file to:                    #
#  /etc/jellyfin-webdav/.env                                         #
#  Then edit your local copy safely.                                 #
#                                                                    #
######################################################################

####################################################
#              WebDAV Configuration                #
####################################################

# Path to the mounted WebDAV directory.
# Leave empty if usung your WebDAV root directory.
# Default:
WEBDAV_PATH=

# Interval (in seconds) to refresh the WebDAV content.
# Set how often your media directory should be scanned.
# Default: 60 seconds
WEBDAV_REFRESH_INTERVAL=60

# Initial delay (in seconds) before the first WebDAV refresh occurs.
# Useful for letting mounts settle before starting the scan loop.
# Default: 15 seconds
WEBDAV_REFRESH_INITIAL_DELAY=15

# VFS cache mode for rclone mount.
# Recommended: full (for media servers).
# Options: off, minimal, writes, full
# Default: full
WEBDAV_VFS_CACHE_MODE=full

# Maximum size of the VFS cache.
# Example: 10G
# Default: 10G
WEBDAV_VFS_CACHE_MAX_SIZE=10G

# Maximum age of items in the VFS cache.
# Example: 1h, 24h
# Default: 1h
WEBDAV_VFS_CACHE_MAX_AGE=1h

# Size of chunks to read ahead while streaming.
# Larger values improve performance for big files.
# Example: 32M
# Default: 32M
WEBDAV_VFS_READ_CHUNK_SIZE=32M

# Upper limit on chunk size for read-ahead.
# Helps control memory usage.
# Example: 512M
# Default: 512M
WEBDAV_VFS_READ_CHUNK_SIZE_LIMIT=512M

# Buffer size per open file when streaming media.
# Helps improve playback buffering.
# Example: 8M
# Default: 8M
WEBDAV_BUFFER_SIZE=8M

# Number of threads to use for downloading chunks.
# Improves download speed for large files.
# Example: 4
# Default: 4
WEBDAV_MULTI_THREAD_STREAMS=4

# VFS cutoff mode behavior for large files.
# Options: hard, soft
# - hard: disables streaming if cache space is low
# - soft: streams even if cache is full (risky for Jellyfin)
# Default: hard
WEBDAV_CUTOFF_MODE=hard

##############################################
#        Jellyfin Scan Configuration         #
##############################################

# Enable automatic Jellyfin library scanning when new media is detected.
# Accepts: true or false (case-sensitive)
# Default: true
JELLYFIN_ENABLE_SCAN=true

# Delay (in seconds) before triggering a Jellyfin scan.
# Useful if files need time to finish mounting.
# Default: 10 seconds
JELLYFIN_SCAN_DELAY=10

# URL to your Jellyfin Media Server.
# Usually http://localhost:8096 or http://<host>:8096
# Default: http://localhost:8096
JELLYFIN_URL=http://localhost:8096

# Jellyfin API token — REQUIRED if you want to trigger library scans.
# You can get your API key from the Jellyfin dashboard under:
# Administration > API Keys
# If not set, library scanning will be skipped even if JELLYFIN_ENABLE_SCAN is true.
# Default:
JELLYFIN_TOKEN=
